<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patient Management | HealthLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #4f46e5;
      --primary-soft: #eef2ff;
      --primary-dark: #3730a3;
      --bg-body: #f1f5f9;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-sub: #64748b;
      --accent-red: #ef4444;
      --accent-green: #10b981;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      padding: 30px 20px;
      line-height: 1.6;
    }

    .wrapper { max-width: 1200px; margin: 0 auto; }

    /* Top Stats Bar */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: var(--card-bg);
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
    }

    .stat-card small { color: var(--text-sub); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    .stat-card strong { font-size: 1.5rem; margin-top: 5px; color: var(--primary); }

    /* Header & Actions */
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 30px;
      gap: 20px;
      flex-wrap: wrap;
    }

    h1 { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; }

    .search-box {
      flex-grow: 1;
      max-width: 400px;
      position: relative;
    }

    .search-box input {
      width: 100%;
      padding: 12px 16px 12px 40px;
      border-radius: 10px;
      border: 1px solid var(--border);
      outline: none;
      font-family: inherit;
      transition: all 0.2s;
    }

    .search-box input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }

    .search-box::before {
      content: '🔍';
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.9rem;
      opacity: 0.5;
    }

    .add-patient-btn {
      text-decoration: none;
      background: var(--primary);
      color: white;
      padding: 12px 24px;
      border-radius: 10px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .add-patient-btn:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: var(--shadow-md); }

    /* Patient Grid */
    .patient-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 24px;
    }

    .patient-card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 24px;
      border: 1px solid var(--border);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
    }

    .patient-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
      border-color: var(--primary-soft);
    }

    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .patient-card h3 { font-size: 1.15rem; font-weight: 700; color: var(--text-main); }

    .status-pill {
      font-size: 0.65rem;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 6px;
      text-transform: uppercase;
    }

    .status-active { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .status-admit { background: #ecfdf5; color: #065f46; border: 1px solid #d1fae5; text-decoration: none; }

    .meta-tags { display: flex; gap: 8px; margin-bottom: 20px; }
    .tag { font-size: 0.75rem; background: var(--bg-body); color: var(--text-sub); padding: 2px 8px; border-radius: 4px; font-weight: 600; }

    .info-block {
      border-top: 1px solid var(--bg-body);
      padding-top: 15px;
      margin-top: auto;
    }

    .data-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 8px;
    }

    .data-line label { color: var(--text-sub); font-weight: 500; }
    .data-line span { font-weight: 700; color: var(--text-main); }

    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 20px;
    }

    .btn-outline {
      text-decoration: none;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--border);
      color: var(--text-main);
      transition: all 0.2s;
    }

    .btn-outline:hover { background: var(--primary); color: white; border-color: var(--primary); }

    .btn-fill {
      text-decoration: none;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 10px;
      border-radius: 8px;
      background: var(--primary-soft);
      color: var(--primary);
      transition: all 0.2s;
    }

    .btn-fill:hover { background: var(--primary); color: white; }

    @media (max-width: 600px) {
      .dashboard-header { flex-direction: column; align-items: stretch; }
      .search-box { max-width: none; }
    }
  </style>
</head>

<body>

<%- include('./navbar') %>

<div class="wrapper">
  
  <div class="stats-grid">
    <div class="stat-card">
      <small>Total Patients</small>
      <strong><%= patients.length %></strong>
    </div>
    <div class="stat-card">
      <small>Active IPD</small>
      <strong style="color: var(--accent-red);">
        <%= patients.filter(p => p.activeWard).length %>
      </strong>
    </div>
    <div class="stat-card">
      <small>Available Doctors</small>
      <strong>Hospital Staff</strong>
    </div>
  </div>

  <div class="dashboard-header">
    <div>
      <h1>Patient Directory</h1>
      <p style="color: var(--text-sub); font-size: 0.9rem;">Manage medical records and admissions</p>
    </div>

    <div class="search-box">
      <input type="text" id="patientSearch" placeholder="Search by name or ID...">
    </div>

    <a href="/addPatient" class="add-patient-btn">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add Patient
    </a>
  </div>

  <div class="patient-container" id="patientList">
    <% patients.forEach(patient => { %>
      <div class="patient-card">
        <div class="card-head">
          <h3><%= patient.name %></h3>
          <% if (!patient.activeWard) { %>
            <a href="/ward/admit/<%= patient._id %>" class="status-pill status-admit">+ Admit</a>
          <% } else { %>
            <span class="status-pill status-active">IPD Active</span>
          <% } %>
        </div>

        <div class="meta-tags">
          <span class="tag"><%= patient.age %> Yrs</span>
          <span class="tag"><%= patient.gender %></span>
        </div>

        <div class="info-block">
          <div class="data-line">
            <label>Primary Physician</label>
            <span>
              <% if (patient.consultations && patient.consultations.length > 0) { 
                   const latest = patient.consultations[patient.consultations.length - 1];
              %>
                Dr. <%= latest.doctor ? latest.doctor.name : 'N/A' %>
              <% } else { %>
                --
              <% } %>
            </span>
          </div>
          <div class="data-line">
            <label>Prescriptions</label>
            <span><%= patient.medicines ? patient.medicines.length : 0 %> active</span>
          </div>
        </div>

        <div class="card-actions">
          <a href="/viewReport/<%= patient._id %>" class="btn-outline">Medical Report</a>
          <a href="/update/<%= patient._id %>" class="btn-fill">Edit Profile</a>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  // Simple search filter
  document.getElementById('patientSearch').addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase();
    const cards = document.querySelectorAll('.patient-card');
    
    cards.forEach(card => {
      const name = card.querySelector('h3').innerText.toLowerCase();
      card.style.display = name.includes(term) ? 'flex' : 'none';
    });
  });
</script>

</body>
</html>