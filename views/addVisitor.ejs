<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visitor Pass | Horizontal Way</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --accent: #0284c7;
      --panel-bg: rgba(255, 255, 255, 0.95);
      --border-light: #e2e8f0;
      --text-main: #0f172a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      margin: 0;
      min-height: 100vh;
      background: #f0f9ff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Main Horizontal Tri-Panel Container */
    .onboarding-grid {
      display: flex;
      width: 98%;
      max-width: 1400px;
      margin: auto;
      gap: 20px;
      padding: 20px;
      perspective: 2000px;
    }

    /* Panel Styling */
    .panel {
      flex: 1;
      background: var(--panel-bg);
      border-radius: 24px;
      padding: 35px;
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border-light);
      opacity: 0;
      /* 3D Flip Animation */
      animation: horizontalFlip 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    /* Staggered Delay for the Tri-Panel Look */
    .p-1 { animation-delay: 0.1s; border-top: 5px solid #7dd3fc; }
    .p-2 { animation-delay: 0.3s; border-top: 5px solid #0ea5e9; }
    .p-3 { animation-delay: 0.5s; border-top: 5px solid #0369a1; }

    .step-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 30px;
    }

    .step-num {
      background: var(--accent);
      color: white;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.75rem;
    }

    .step-header h3 {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #64748b;
    }

    .input-wrapper { margin-bottom: 22px; }

    label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    input, select {
      width: 100%;
      padding: 14px;
      border: 1px solid var(--border-light);
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      background: #f8fafc;
      transition: all 0.3s ease;
    }

    input:focus, select:focus {
      outline: none;
      border-color: var(--accent);
      background: white;
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
      transform: scale(1.01);
    }

    /* Bottom Action Bar */
    .action-bar {
      width: 100%;
      padding: 30px;
      text-align: center;
      animation: fadeInUp 0.8s both 0.7s;
    }

    .btn-register {
      background: var(--accent);
      color: white;
      padding: 18px 80px;
      border-radius: 50px;
      border: none;
      font-weight: 800;
      font-size: 1.1rem;
      cursor: pointer;
      transition: 0.4s;
      box-shadow: 0 10px 25px rgba(2, 132, 199, 0.3);
    }

    .btn-register:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 40px rgba(2, 132, 199, 0.4);
      background: #0369a1;
    }

    /* Keyframe Animations */
    @keyframes horizontalFlip {
      0% { opacity: 0; transform: rotateY(-30deg) scale(0.9); }
      100% { opacity: 1; transform: rotateY(0deg) scale(1); }
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 1100px) {
      .onboarding-grid { flex-direction: column; }
      .panel { width: 100%; }
    }
  </style>
</head>
<body>

  <%- include('./navbar') %>

  <form action="/addVisitor" method="POST">
    <div class="onboarding-grid">
      
      <div class="panel p-1">
        <div class="step-header">
          <div class="step-num">01</div>
          <h3>Association</h3>
        </div>
        
        <div class="input-wrapper">
          <label for="patientName">Select Patient</label>
          <select id="patientName" name="patientName" required>
            <option value="" disabled selected>Search Patient...</option>
            <% patients.forEach(patient => { %>
              <option value="<%= patient._id %>"><%= patient.name %></option>
            <% }) %>
          </select>
        </div>
        <p style="font-size: 0.8rem; color: #64748b; line-height: 1.5;">
          Choose the patient the visitor is here to see. This ensures record tracking for safety.
        </p>
      </div>

      <div class="panel p-2">
        <div class="step-header">
          <div class="step-num">02</div>
          <h3>Visitor Details</h3>
        </div>

        <div class="input-wrapper">
          <label for="name">Visitor Full Name</label>
          <input type="text" id="name" name="name" placeholder="Enter guest name" required>
        </div>

        <div class="input-wrapper">
          <label for="contact">Contact Number</label>
          <input type="text" id="contact" name="contact" pattern="[0-9]{10}" placeholder="10-digit number" required>
        </div>
      </div>

      <div class="panel p-3">
        <div class="step-header">
          <div class="step-num">03</div>
          <h3>Visit Schedule</h3>
        </div>

        <div class="input-wrapper">
          <label for="visitTime">Entry Date & Time</label>
          <input type="datetime-local" id="visitTime" name="visitTime" required>
        </div>

        <div style="margin-top: 30px; background: #f0f9ff; padding: 20px; border-radius: 15px; border: 1px dashed #bae6fd;">
          <p style="font-size: 0.75rem; font-weight: 600; color: #0369a1; text-align: center;">
            Generating Visitor Pass upon confirmation.
          </p>
        </div>
      </div>

    </div>

    <div class="action-bar">
      <button type="submit" class="btn-register">Confirm & Add Visitor</button>
    </div>
  </form>

</body>
</html>