<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HMS | Staff Credentials</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --brand: #0066ff;
      --brand-gradient: linear-gradient(135deg, #0066ff 0%, #004dc2 100%);
      --bg: #f8fafc;
      --card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --input-fill: #f9fbfc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background-image: 
        radial-gradient(at 0% 0%, rgba(0, 102, 255, 0.05) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(0, 102, 255, 0.02) 0px, transparent 50%);
    }

    /* Centered Layout */
    .viewport {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .edit-card {
      width: 100%;
      max-width: 520px;
      background: var(--card);
      border-radius: 32px;
      padding: 48px;
      border: 1px solid var(--border);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.06);
      position: relative;
      animation: cardSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes cardSlideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Header Styling */
    .header {
      text-align: center;
      margin-bottom: 36px;
    }

    .header .icon-circle {
      width: 60px;
      height: 60px;
      background: var(--brand-gradient);
      border-radius: 18px;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 24px;
      box-shadow: 0 10px 20px rgba(0, 102, 255, 0.2);
    }

    .header h1 {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }

    .header p {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* Form Elements */
    .form-group { margin-bottom: 24px; }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 8px;
      padding-left: 2px;
    }

    .form-group input, .form-group select {
      width: 100%;
      padding: 14px 18px;
      background: var(--input-fill);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-main);
      transition: all 0.25s ease;
    }

    .form-group input:focus, .form-group select:focus {
      outline: none;
      background: white;
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(0, 102, 255, 0.08);
      transform: translateY(-1px);
    }

    /* Grid for Twin Inputs */
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    /* Button System */
    .actions {
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .btn-update {
      padding: 16px;
      background: var(--brand-gradient);
      color: white;
      border: none;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 10px 20px -5px rgba(0, 102, 255, 0.3);
    }

    .btn-update:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 30px -10px rgba(0, 102, 255, 0.4);
    }

    .btn-update:active { transform: translateY(0); }

    .btn-back {
      text-align: center;
      padding: 12px;
      text-decoration: none;
      color: var(--text-muted);
      font-size: 14px;
      font-weight: 600;
      transition: 0.2s;
    }

    .btn-back:hover { color: var(--text-main); }

    /* Remove arrows from number input */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  </style>
</head>
<body>

  <%- include('./navbar') %>

  <div class="viewport">
    <div class="edit-card">
      <header class="header">
        <div class="icon-circle">👨‍⚕️</div>
        <h1>Update Practitioner</h1>
        <p>Modify staff profile and professional rates</p>
      </header>

      <form action="/update/doctor/<%= doctor._id %>" method="POST">
        
        <div class="form-group">
          <label>Full Legal Name</label>
          <input type="text" name="name" value="<%= doctor.name %>" placeholder="e.g. Dr. Alexander Pierce" required>
        </div>

        <div class="row">
          <div class="form-group">
            <label>Gender</label>
            <select name="gender" required>
              <option value="Male" <%= doctor.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= doctor.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= doctor.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Consultation Fee (₹)</label>
            <input type="number" name="consultationFee" value="<%= doctor.consultationFee %>" placeholder="800" required>
          </div>
        </div>

        <div class="form-group">
          <label>Specialization Field</label>
          <input type="text" name="field" value="<%= doctor.field %>" placeholder="e.g. Neurologist" required>
        </div>

        <div class="form-group">
          <label>Emergency Contact</label>
          <input type="text" name="contact" value="<%= doctor.contact %>" placeholder="+91 98765 43210" required>
        </div>

        <div class="actions">
          <button type="submit" class="btn-update">Save Professional Profile</button>
          <a href="javascript:history.back()" class="btn-back">Discard Changes</a>
        </div>

      </form>
    </div>
  </div>

</body>
</html>