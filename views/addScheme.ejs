<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Insurance Management | Add Scheme</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

  <style>
    :root {
      --scheme-indigo: #4338ca;
      --scheme-violet: #6366f1;
      --bg-slate: #f8fafc;
      --card-white: #ffffff;
      --text-muted: #64748b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #e2e8f0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Main Horizontal Wrapper */
    .horizontal-scheme-card {
      max-width: 1100px;
      width: 95%;
      margin: auto;
      background: var(--card-white);
      display: flex;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
      animation: zoomIn 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Left Aesthetic Info Panel */
    .promo-panel {
      flex: 0.9;
      background: var(--scheme-indigo);
      padding: 60px;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background-image: linear-gradient(135deg, #3730a3 0%, #4f46e5 100%);
      position: relative;
    }

    .promo-panel h2 {
      font-size: 2.2rem;
      font-weight: 800;
      margin-bottom: 20px;
      line-height: 1.1;
      animation: fadeInLeft 0.8s both;
    }

    .promo-panel p {
      color: #c7d2fe;
      font-size: 1rem;
      line-height: 1.6;
      animation: fadeInLeft 0.8s both 0.2s;
    }

    /* Right Form Content Panel */
    .form-panel {
      flex: 1.1;
      padding: 50px 60px;
    }

    .scheme-grid {
      display: grid;
      grid-template-columns: 1fr 1fr; /* Horizontal grid columns */
      gap: 24px;
    }

    .full-width { grid-column: span 2; }

    .input-group {
      display: flex;
      flex-direction: column;
      animation: fadeInRight 0.5s both;
    }

    /* Staggered load delays */
    .input-group:nth-child(1) { animation-delay: 0.1s; }
    .input-group:nth-child(2) { animation-delay: 0.2s; }
    .input-group:nth-child(3) { animation-delay: 0.3s; }
    .input-group:nth-child(4) { animation-delay: 0.4s; }
    .input-group:nth-child(5) { animation-delay: 0.5s; }

    label {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 8px;
      letter-spacing: 0.05em;
    }

    input, select {
      padding: 14px 16px;
      border: 2px solid #f1f5f9;
      border-radius: 12px;
      background: #f8fafc;
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    input:focus, select:focus {
      outline: none;
      border-color: var(--scheme-violet);
      background: white;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .save-container {
      grid-column: span 2;
      margin-top: 10px;
    }

    .btn-save {
      width: 100%;
      background: var(--scheme-indigo);
      color: white;
      padding: 16px;
      border: none;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 10px 15px -3px rgba(67, 56, 202, 0.3);
    }

    .btn-save:hover {
      background: var(--scheme-violet);
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.4);
    }

    /* Mobile Adaptability */
    @media (max-width: 900px) {
      .horizontal-scheme-card { flex-direction: column; margin: 20px auto; }
      .promo-panel { padding: 40px; text-align: center; }
      .form-panel { padding: 30px; }
      .scheme-grid { grid-template-columns: 1fr; }
      .full-width, .save-container { grid-column: span 1; }
    }
  </style>
</head>

<body>

  <%- include('./navbar') %>

  <div class="horizontal-scheme-card">
    <div class="promo-panel">
      <h2>Scheme <br>& Coverage</h2>
      <p>Configure medical insurance plans, percentage subsidies, or government health schemes for automated billing.</p>
    </div>

    <div class="form-panel">
      <form action="/addScheme" method="POST" class="scheme-grid">
        
        <div class="input-group full-width">
          <label>Scheme Name</label>
          <input type="text" name="name" placeholder="e.g., Ayushman Bharat" required>
        </div>

        <div class="input-group full-width">
          <label>Description</label>
          <input type="text" name="description" placeholder="Brief details about coverage">
        </div>

        <div class="input-group">
          <label>Coverage Type</label>
          <select name="coverageType" required>
            <option value="percentage">Percentage (%)</option>
            <option value="fixed">Fixed Amount (₹)</option>
          </select>
        </div>

        <div class="input-group">
          <label>Coverage Value</label>
          <input type="number" name="coverageValue" placeholder="e.g., 50" required>
        </div>

        <div class="input-group full-width">
          <label>Maximum Claim Limit (₹)</label>
          <input type="number" name="maxLimit" placeholder="Upper limit per patient">
        </div>

        <div class="save-container">
          <button type="submit" class="btn-save animate__animated animate__pulse animate__infinite animate__slow">
            Register Scheme
          </button>
        </div>

      </form>
    </div>
  </div>

</body>
</html>