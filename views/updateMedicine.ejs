<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HMS | Inventory Editor</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #0066ff;
      --success: #00c853;
      --bg: #f8fafc;
      --panel: #ffffff;
      --text: #111827;
      --text-light: #6b7280;
      --border: #e5e7eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background-image: 
        radial-gradient(circle at 20% 20%, rgba(0, 102, 255, 0.03) 0%, transparent 40%),
        radial-gradient(circle at 80% 80%, rgba(0, 200, 83, 0.03) 0%, transparent 40%);
    }

    /* Professional Centering */
    .viewport {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .edit-card {
      width: 100%;
      max-width: 500px;
      background: var(--panel);
      border-radius: 32px;
      padding: 48px;
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Top Visual Accent */
    .edit-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 6px;
      background: linear-gradient(90deg, var(--primary), var(--success));
    }

    .header {
      margin-bottom: 32px;
      text-align: center;
    }

    .header h1 {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--text);
    }

    .header p {
      font-size: 14px;
      color: var(--text-light);
      margin-top: 6px;
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 24px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-light);
      margin-bottom: 8px;
      padding-left: 2px;
    }

    .form-group input, .form-group select {
      width: 100%;
      padding: 14px 18px;
      border: 1.5px solid var(--border);
      border-radius: 14px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      background: #fafbfc;
      transition: all 0.2s;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--primary);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(0, 102, 255, 0.08);
    }

    /* Row Layout */
    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    /* Premium Button */
    .update-btn {
      width: 100%;
      padding: 18px;
      background: var(--text);
      color: white;
      border: none;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s;
      margin-top: 10px;
    }

    .update-btn:hover {
      background: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0, 102, 255, 0.2);
    }

    .back-btn {
      display: block;
      text-align: center;
      margin-top: 24px;
      color: var(--text-light);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }

    .back-btn:hover { color: var(--text); }

    /* Hide Number Arrows */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  </style>
</head>
<body>

  <%- include('./navbar') %>

  <div class="viewport">
    <div class="edit-card">
      <header class="header">
        <h1>Update Medicine</h1>
        <p>Modify stock details and pricing</p>
      </header>

      <form action="/update/medicine/<%= medicine._id %>" method="POST">
        
        <div class="form-group">
          <label>Medicine Name</label>
          <input type="text" name="name" value="<%= medicine.name %>" placeholder="e.g. Paracetamol" required>
        </div>

        <div class="input-row">
          <div class="form-group">
            <label>Type</label>
            <input type="text" name="type" value="<%= medicine.type %>" placeholder="e.g. Tablet" required>
          </div>
          <div class="form-group">
            <label>Dosage</label>
            <input type="text" name="dosage" value="<%= medicine.dosage %>" placeholder="e.g. 500mg" required>
          </div>
        </div>

        <div class="input-row">
          <div class="form-group">
            <label>Frequency</label>
            <input type="text" name="frequency" value="<%= medicine.frequency %>" placeholder="1-0-1" required>
          </div>
          <div class="form-group">
            <label>Price (₹)</label>
            <input type="number" name="price" value="<%= medicine.price %>" placeholder="0.00" required>
          </div>
        </div>

        <button type="submit" class="update-btn">Save Inventory Changes</button>
        
        <a href="javascript:history.back()" class="back-btn">Discard and Go Back</a>
      </form>
    </div>
  </div>

</body>
</html>