<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Doctor | Horizontal Layout</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

  <style>
    :root {
      --primary: #4f46e5;
      --primary-dark: #3730a3;
      --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      --card-bg: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-gradient);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Horizontal Container */
    .horizontal-wrapper {
      max-width: 1100px;
      width: 95%;
      margin: auto;
      background: var(--card-bg);
      display: flex; /* Key for horizontal way */
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
      animation: zoomIn 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Left Branding Side */
    .brand-side {
      flex: 1;
      background: var(--primary);
      padding: 60px;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
    }

    .brand-side h2 { font-size: 2.5rem; margin-bottom: 20px; font-weight: 800; line-height: 1.1; }
    .brand-side p { opacity: 0.8; line-height: 1.6; }

    /* Right Form Side */
    .form-side {
      flex: 1.5;
      padding: 60px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr; /* Two columns horizontal */
      gap: 25px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      animation: fadeInRight 0.5s ease-out both;
    }

    /* Staggered Field Entry */
    .input-group:nth-child(1) { animation-delay: 0.1s; }
    .input-group:nth-child(2) { animation-delay: 0.2s; }
    .input-group:nth-child(3) { animation-delay: 0.3s; }
    .input-group:nth-child(4) { animation-delay: 0.4s; }
    .input-group:nth-child(5) { animation-delay: 0.5s; }

    /* Span full width for specific items */
    .full-width { grid-column: span 2; }

    label {
      font-size: 0.75rem;
      font-weight: 800;
      color: #64748b;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    input, select {
      padding: 14px;
      border: 2px solid #f1f5f9;
      border-radius: 12px;
      background: #f8fafc;
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: var(--primary);
      background: white;
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }

    .btn-container {
      grid-column: span 2;
      margin-top: 20px;
      text-align: right;
    }

    .submit-btn {
      background: var(--primary);
      color: white;
      padding: 16px 40px;
      border-radius: 14px;
      border: none;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }

    .submit-btn:hover {
      background: var(--primary-dark);
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.4);
    }

    /* Mobile Responsive */
    @media (max-width: 900px) {
      .horizontal-wrapper { flex-direction: column; margin: 20px auto; }
      .brand-side { padding: 40px; text-align: center; }
      .form-grid { grid-template-columns: 1fr; }
      .full-width { grid-column: span 1; }
      .btn-container { grid-column: span 1; text-align: center; }
    }
  </style>
</head>
<body>

  <%- include('./navbar') %>

  <div class="horizontal-wrapper">
    <div class="brand-side">
      <div class="animate__animated animate__fadeInLeft">
        <h2>Join the Medical Staff</h2>
        <p>Expand our healthcare network by adding a new specialist to the Evercare database.</p>
      </div>
    </div>

    <div class="form-side">
      <form action="/addDoctor" method="POST" class="form-grid">
        
        <div class="input-group full-width">
          <label>Full Name</label>
          <input type="text" name="name" placeholder="Enter doctor's name" required>
        </div>

        <div class="input-group">
          <label>Gender</label>
          <select name="gender" required>
            <option value="" disabled selected>Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="input-group">
          <label>Specialization</label>
          <input type="text" name="field" placeholder="e.g. Neurology" required>
        </div>

        <div class="input-group">
          <label>Contact Number</label>
          <input type="text" name="contact" placeholder="10-digit number" required>
        </div>

        <div class="input-group">
          <label>Consultation Fee</label>
          <input type="number" name="consultationFee" placeholder="Fee in ₹" required>
        </div>

        <div class="btn-container">
          <button type="submit" class="submit-btn animate__animated animate__pulse animate__infinite animate__slow">
            Confirm & Add Doctor
          </button>
        </div>

      </form>
    </div>
  </div>

</body>
</html>