<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HMS | Active Ward Matrix</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #4f46e5;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --danger: #ef4444;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text);
      padding: 40px 5%;
    }

    .container { max-width: 1200px; margin: 0 auto; }

    /* Consistent Header */
    .matrix-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 2px solid var(--text);
    }

    .matrix-header h1 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -1px;
      text-transform: uppercase;
    }

    .system-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--primary);
      font-weight: 600;
    }

    /* The Data Matrix */
    .matrix-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 24px;
    }

    .unit-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      transition: all 0.2s ease;
      position: relative;
    }

    .unit-card:hover {
      border-color: var(--primary);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
      transform: translateY(-4px);
    }

    /* Unit Meta */
    .unit-meta {
      display: flex;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .unit-id {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
      background: var(--bg);
      padding: 2px 8px;
      border-radius: 4px;
    }

    .status-dot {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 800;
      color: #10b981;
    }

    .dot {
      width: 6px; height: 6px;
      background: #10b981;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    .patient-name {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 20px;
      color: var(--text);
    }

    /* Info Table */
    .info-table {
      border-top: 1px solid var(--border);
      padding-top: 16px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .info-cell label {
      display: block;
      font-size: 10px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 2px;
    }

    .info-cell span {
      font-size: 13px;
      font-weight: 600;
    }

    /* Buttons - Matching your other pages */
    .btn-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 24px;
    }

    .btn-action {
      padding: 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      transition: 0.2s;
      border: 1px solid var(--border);
      cursor: pointer;
      font-family: inherit;
    }

    .btn-manage {
      background: var(--text);
      color: white;
      border: none;
    }

    .btn-manage:hover {
      background: var(--primary);
    }

    .btn-discharge {
      background: transparent;
      color: var(--danger);
      border-color: #fee2e2;
    }

    .btn-discharge:hover {
      background: #fef2f2;
      border-color: var(--danger);
    }

  </style>
</head>
<body>

  <%- include('./navbar') %>

  <div class="container">
    
    <header class="matrix-header">
      <div>
        <div class="system-label">SYSTEM_STATUS: STABLE</div>
        <h1>Active Ward Matrix</h1>
      </div>
      <div style="text-align: right;">
        <span class="unit-id" style="font-size: 14px; padding: 6px 15px;">
          OCCUPANCY: <%= wards.length %>
        </span>
      </div>
    </header>

    <div class="matrix-grid">
      <% wards.forEach(ward => { %>
        <div class="unit-card">
          
          <div class="unit-meta">
            <span class="unit-id">REF_<%= ward._id.toString().slice(-6).toUpperCase() %></span>
            <div class="status-dot">
              <div class="dot"></div> LIVE_MONITOR
            </div>
          </div>

          <div class="patient-name"><%= ward.patient.name %></div>

          <div class="info-table">
            <div class="info-cell">
              <label>Zone</label>
              <span><%= ward.wardCategory %></span>
            </div>
            <div class="info-cell" style="text-align: right;">
              <label>Admitted</label>
              <span style="font-family: 'JetBrains Mono';"><%= ward.admissionDate.toLocaleDateString() %></span>
            </div>
          </div>

          <div class="btn-group">
            <a href="/ward/view/<%= ward._id %>" class="btn-action btn-manage">View Case</a>
            <form action="/ward/discharge/<%= ward._id %>" method="POST" style="display:contents;">
              <button type="submit" class="btn-action btn-discharge">Discharge</button>
            </form>
          </div>

        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>